{
  "name": "luma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm gen:runtime && pnpm gen:manifest && next dev -H 0.0.0.0",
    "build": "pnpm gen:runtime && pnpm gen:manifest && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:security": "node scripts/security-audit.cjs",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:runtime": "node scripts/convert-config.js",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:version": "node scripts/generate-version.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install",
    "build:worker": "pnpm gen:runtime && pnpm gen:manifest && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview:worker": "pnpm build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "pnpm build:worker && opennextjs-cloudflare deploy",
    "upload:worker": "pnpm build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "1.20.8",
    "@paper-design/shaders-react": "^0.0.76",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@react-email/render": "2.0.9",
    "@upstash/redis": "^1.39.0",
    "@vidstack/react": "^1.15.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^22.5.1",
    "lucide-react": "^0.438.0",
    "media-icons": "^1.1.5",
    "next": "^15.5.27",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-icons": "^5.7.0",
    "react-turnstile": "^1.1.5",
    "recharts": "^3.10.1",
    "redis": "^4.7.1",
    "styled-components": "^6.5.3",
    "sweetalert2": "^11.26.25",
    "swiper": "^12.2.0",
    "tailwind-merge": "^2.6.1",
    "vidstack": "^0.6.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "24.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^7.0.4",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.13",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.28",
      "semver@>=7 <7.5.2": "^7.7.4",
      "webpack": "^5.111.1",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "@istanbuljs/load-nyc-config>js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
